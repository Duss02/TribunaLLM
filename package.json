{
  "name": "tribunallm",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "models": "tsx --env-file-if-exists=.env.local scripts/models.ts",
    "debate:cli": "tsx --env-file-if-exists=.env.local scripts/debate-cli.ts",
    "tournament": "tsx --env-file-if-exists=.env.local scripts/tournament.ts",
    "leaderboard:build": "tsx scripts/leaderboard-build.ts",
    "library:build": "tsx scripts/library-build.ts",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "spend": "tsx scripts/spend.ts",
    "analysis:sweep": "tsx scripts/analysis/threshold-sweep.ts",
    "analysis:review": "tsx scripts/analysis/review-sheet.ts",
    "analysis:perturb": "tsx --env-file-if-exists=.env.local scripts/analysis/perturb.ts",
    "analysis:recall": "tsx --env-file-if-exists=.env.local scripts/analysis/retrieval-recall.ts",
    "analysis:judge2": "tsx --env-file-if-exists=.env.local scripts/analysis/second-judge.ts",
    "analysis:position": "tsx --env-file-if-exists=.env.local scripts/analysis/position-bias.ts",
    "analysis:perturb-variants": "tsx --env-file-if-exists=.env.local scripts/analysis/perturb-variants.ts",
    "analysis:rejudge": "tsx --env-file-if-exists=.env.local scripts/analysis/rejudge.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/openai-compatible": "^3.0.65",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.130",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.34.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
