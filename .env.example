# Copy to .env.local and fill in what you have. Nothing here is sent to the browser.
# The same keys can be pasted on the Settings page instead, which keeps them in the browser;
# the command-line tools (pnpm models, pnpm debate:cli, pnpm tournament) read only this file.

# Judge. Get a key at https://api.typesafe.ai (required unless JEV_MOCK=1).
TYPESAFE_API_KEY=
# Optional. Overrides the pinned judge model (default jev-1.13.0). Thresholds are only validated for the default.
# TYPESAFE_MODEL=
# Set to 1 to run with a fake judge and scripted debaters, no keys needed.
# JEV_MOCK=1

# Debaters, route 1 (preferred): one key for the whole roster. https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# Debaters, route 2: widest catalogue. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://console.x.ai
XAI_API_KEY=
